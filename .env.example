# Required
ANTHROPIC_API_KEY=

# Optional overrides
# TRANSLATE_MODEL=claude-sonnet-5-5   # model for translation (claude-opus-5-5 for best quality)
# SMALL_MODEL=claude-haiku-4-5        # model for term extraction / summaries / relationship suggestions
# TRANSLATE_EFFORT=medium             # low | medium | high
# ANTHROPIC_FALLBACKS=off             # disable server-side refusal fallbacks
# CHUNK_TARGET=1800                   # target Chinese characters per chunk
# CHUNK_MAX=2500
# SUMMARY_CHAPTERS=3                  # how many previous chapter summaries go into the prompt
# DATABASE_PATH=/app/data/novel.db
